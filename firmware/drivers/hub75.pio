; HUB75 driver for a 64x32, 1/16-scan RGB matrix.
;
; Two state machines cooperate, sequenced by core 1:
;   hub75_data  shifts one column per byte into the panel's shift registers.
;   hub75_row   blanks the panel, selects a row, latches the shifted data and
;               then holds OE low for a programmable number of cycles
;               (binary-coded modulation: plane p is lit for base << p cycles).
; Because the panel latches, the next row's data shifts in while the current
; row is still lit.

.program hub75_row
.side_set 2
; side-set bit 0 = LAT, bit 1 = OE (active low)
; FIFO word: bits [3:0] row address, bits [31:4] on-time in cycles minus one.
.wrap_target
    out pins, 4  [7]   side 0b10   ; blank the panel, drive row address A-D
    out x, 28    [7]   side 0b11   ; pulse LAT while still blanked
lit:
    jmp x-- lit        side 0b00   ; OE low for x + 1 cycles
.wrap

% c-sdk {
static inline void hub75_row_program_init(PIO pio, uint sm, uint offset, uint row_base_pin, uint latch_base_pin) {
    // Start blanked (OE high) so nothing flashes before the first frame.
    pio_sm_set_pins_with_mask(pio, sm, 2u << latch_base_pin, 3u << latch_base_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, row_base_pin, 4, true);
    pio_sm_set_consecutive_pindirs(pio, sm, latch_base_pin, 2, true);
    for (uint i = row_base_pin; i < row_base_pin + 4; ++i) pio_gpio_init(pio, i);
    pio_gpio_init(pio, latch_base_pin);
    pio_gpio_init(pio, latch_base_pin + 1);

    pio_sm_config c = hub75_row_program_get_default_config(offset);
    sm_config_set_out_pins(&c, row_base_pin, 4);
    sm_config_set_sideset_pins(&c, latch_base_pin);
    sm_config_set_out_shift(&c, true, true, 32);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program hub75_data
.side_set 1
; side-set = CLK. Each FIFO byte is one column: bits [5:0] = R0 G0 B0 R1 G1 B1.
; Autopull refills the OSR every 4 columns.
.wrap_target
    out pins, 6        side 0      ; present column data, CLK low
    out null, 2        side 1      ; rising edge clocks it in
.wrap

% c-sdk {
static inline void hub75_data_program_init(PIO pio, uint sm, uint offset, uint rgb_base_pin, uint clock_pin, float clkdiv) {
    pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin, 1, true);
    for (uint i = rgb_base_pin; i < rgb_base_pin + 6; ++i) pio_gpio_init(pio, i);
    pio_gpio_init(pio, clock_pin);

    pio_sm_config c = hub75_data_program_get_default_config(offset);
    sm_config_set_out_pins(&c, rgb_base_pin, 6);
    sm_config_set_sideset_pins(&c, clock_pin);
    sm_config_set_out_shift(&c, true, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

// Blocks until the state machine has drained its FIFO and is waiting for more.
static inline void hub75_wait_tx_stall(PIO pio, uint sm) {
    const uint32_t mask = 1u << (PIO_FDEBUG_TXSTALL_LSB + sm);
    pio->fdebug = mask;
    while (!(pio->fdebug & mask)) tight_loop_contents();
}
%}
